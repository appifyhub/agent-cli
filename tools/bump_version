#!/usr/bin/env sh

. "$(dirname "$0")/messages"

usage() {
    echoerr "Usage: $0 {major|minor|patch}"
}

if [ ! -f "go.mod" ]; then
    echowarn "No 'go.mod' found. This script must be run from the project root!" >&2
    echoerr "Exiting..." -n >&2
    exit 1
fi

BUMP_TYPE="$1"
case "$BUMP_TYPE" in
    major|minor|patch)
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac

VERSION_FILE="VERSION"

if [ ! -f "$VERSION_FILE" ]; then
    echoerr "Missing '$VERSION_FILE'." >&2
    exit 1
fi

CURRENT_VERSION=$(awk '$0 ~ /^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$/ { print $0; exit }' "$VERSION_FILE")

if [ -z "$CURRENT_VERSION" ] || [ "$(wc -l < "$VERSION_FILE" | tr -d ' ')" != "1" ]; then
    echoerr "'$VERSION_FILE' must contain exactly one semantic version (MAJOR.MINOR.PATCH)." >&2
    exit 1
fi

MAJOR=$(printf "%s\n" "$CURRENT_VERSION" | awk -F "." "{ print \$1 }")
MINOR=$(printf "%s\n" "$CURRENT_VERSION" | awk -F "." "{ print \$2 }")
PATCH=$(printf "%s\n" "$CURRENT_VERSION" | awk -F "." "{ print \$3 }")

case "$BUMP_TYPE" in
    major)
        NEW_VERSION="$((MAJOR + 1)).0.0"
        ;;
    minor)
        NEW_VERSION="$MAJOR.$((MINOR + 1)).0"
        ;;
    patch)
        NEW_VERSION="$MAJOR.$MINOR.$((PATCH + 1))"
        ;;
esac

TMP_VERSION=$(mktemp "${TMPDIR:-/tmp}/bump_version_version.XXXXXX")
trap 'rm -f "$TMP_VERSION"' EXIT

printf "%s\n" "$NEW_VERSION" > "$TMP_VERSION" || {
    echoerr "Failed to prepare '$VERSION_FILE'." >&2
    exit 1
}

mv "$TMP_VERSION" "$VERSION_FILE"

UPDATED_VERSION=$(awk '$0 ~ /^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$/ { print $0; exit }' "$VERSION_FILE")

if [ "$UPDATED_VERSION" != "$NEW_VERSION" ]; then
    echoerr "Version update failed: '$VERSION_FILE' has $UPDATED_VERSION." >&2
    exit 1
fi

echoinfo "Version bumped: $CURRENT_VERSION -> $NEW_VERSION"
