#!/usr/bin/env sh

. "$(dirname "$0")/messages"
. "$(dirname "$0")/variants"

# publishes a GitHub release through GoReleaser, mirroring the backend's pipelines:
#   beta  abot-dev and agent-cli-dev   tag v<VERSION>-beta   pre-release, from pull requests to release
#   ga    abot and agent-cli           tag v<VERSION>        release, from pushes to release
# every binary reports the plain VERSION; the tags differ only because GitHub tags are repository-wide,
# and each tag is published once, so the next release candidate needs a bumped VERSION
#
# usage: tools/release {beta|ga} [--check|--snapshot]
#   --check     validate VERSION and the tag, change nothing
#   --snapshot  build every artifact into dist/ without tagging or publishing
# the checked-out commit (HEAD) is tagged and released: GoReleaser refuses a tag that does not point at HEAD
# environment: GITHUB_TOKEN for GoReleaser; GITHUB_OUTPUT receives release_tag and release_version; GORELEASER and GH name the executables

usage() {
    echoerr "Usage: $0 {beta|ga} [--check|--snapshot]"
}

if [ ! -f "go.mod" ]; then
    echowarn "No 'go.mod' found. This script must be run from the project root!" >&2
    echoerr "Exiting..." -n >&2
    exit 1
fi

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    usage >&2
    exit 1
fi

QUALITY="$1"
MODE="${2:-}"
case "$QUALITY" in
    beta)
        BRANDED="abot-dev"
        GENERIC="agent-cli-dev"
        ;;
    ga)
        BRANDED="abot"
        GENERIC="agent-cli"
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
case "$MODE" in
    ""|--check|--snapshot)
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac

VERSION=$(read_version) || exit 1
GORELEASER=${GORELEASER:-goreleaser}
GH=${GH:-gh}

if [ "$QUALITY" = "ga" ]; then
    TAG="v$VERSION"
    TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+$'
else
    TAG="v$VERSION-beta"
    TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+-beta$'
fi

# releases always use the fixed backends from tools/variants
unset THE_AGENT_CLI_BUILD_API_URL
load_variant "$BRANDED"
export THE_AGENT_CLI_BRANDED_NAME="$VARIANT_NAME"
export THE_AGENT_CLI_BRANDED_API_URL="$VARIANT_API_URL"
load_variant "$GENERIC"
export THE_AGENT_CLI_GENERIC_NAME="$VARIANT_NAME"
export THE_AGENT_CLI_GENERIC_API_URL="$VARIANT_API_URL"
export THE_AGENT_CLI_PRODUCT_URL="$VARIANT_PRODUCT_URL"
export THE_AGENT_CLI_VERSION="$VERSION"
export GORELEASER_CURRENT_TAG="$TAG"

set --
if [ "$QUALITY" != "ga" ]; then
    set -- --skip=nfpm,homebrew,scoop
fi

if [ "$MODE" = "--snapshot" ]; then
    "$GORELEASER" release --snapshot --clean "$@" || {
        echoerr "Snapshot build failed." >&2
        exit 1
    }
    echoinfo "Built $BRANDED and $GENERIC $VERSION snapshots into dist/"
    exit 0
fi

git fetch --tags --force origin >/dev/null 2>&1 || true

if git rev-parse --quiet --verify "refs/tags/$TAG" >/dev/null 2>&1 \
    || [ -n "$(git ls-remote --tags origin "refs/tags/$TAG" 2>/dev/null)" ]; then
    echoerr "Tag '$TAG' already exists. Bump the version with tools/bump_version and try again." >&2
    exit 1
fi

if [ "$MODE" = "--check" ]; then
    echoinfo "Ready to release $BRANDED and $GENERIC $VERSION as '$TAG'"
    exit 0
fi

PREVIOUS_TAG=$(git tag --list 'v*' --sort=-v:refname | grep -E "$TAG_PATTERN" | head -n 1)

git -c user.name="the-agent-abot" -c user.email="the-agent-abot@users.noreply.github.com" \
    tag -a "$TAG" -m "Release $VERSION ($QUALITY)" HEAD || {
    echoerr "Could not create the tag '$TAG'." >&2
    exit 1
}
git push --quiet origin "refs/tags/$TAG" || {
    git tag -d "$TAG" >/dev/null 2>&1
    echoerr "Could not push the tag '$TAG'." >&2
    exit 1
}

if [ -n "$PREVIOUS_TAG" ]; then
    echoinfo "Release notes start after '$PREVIOUS_TAG'"
    export GORELEASER_PREVIOUS_TAG="$PREVIOUS_TAG"
fi

if ! "$GORELEASER" release --clean "$@"; then
    echoerr "Publishing failed; removing '$TAG' so the release can be retried." >&2
    "$GH" release delete "$TAG" --yes >/dev/null 2>&1 || true
    git push --quiet origin ":refs/tags/$TAG" >/dev/null 2>&1 || true
    git tag -d "$TAG" >/dev/null 2>&1 || true
    exit 1
fi

if [ -n "$GITHUB_OUTPUT" ]; then
    {
        printf "release_tag=%s\n" "$TAG"
        printf "release_version=%s\n" "$VERSION"
    } >> "$GITHUB_OUTPUT"
fi
echoinfo "Released $BRANDED and $GENERIC $VERSION as '$TAG'"
